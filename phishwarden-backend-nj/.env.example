# Configuración de Base de Datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Seguridad y Autenticación JWT
JWT_SECRET="super-secret-jwt-key-2026"
JWT_EXPIRES_IN="24h"

# Modo de Despacho de Simulaciones: 'sandbox' (logs sin envío) o 'live' (proveedores reales)
DISPATCH_MODE="sandbox"

# URLs Públicas para Rastreo y Redirección
BACKEND_PUBLIC_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Duración máxima en horas de campañas en curso antes del cierre automático (default: 72)
CAMPAIGN_DURATION_HOURS=72

# Proveedor de Correo Electrónico (Resend) - Vector Phishing
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="simulaciones@phishwarden.com"

# Proveedor de Mensajería SMS (Twilio) - Vector Smishing
TWILIO_ACCOUNT_SID="AC1234567890abcdef1234567890abcdef"
TWILIO_AUTH_TOKEN="auth_token_secret_123456"
TWILIO_PHONE_NUMBER="+12345678901"

# Orígenes Permitidos CORS (separados por coma)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Firebase Cloud Messaging (FCM) - Notificaciones Push App Móvil (Fase 3)
FCM_MODE="sandbox"
FIREBASE_PROJECT_ID="phishwarden-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@phishwarden-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
